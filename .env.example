# Database
POSTGRES_USER=lumea
POSTGRES_PASSWORD=lumea
POSTGRES_DB=lumea
DATABASE_URL=postgresql://lumea:lumea@localhost:5432/lumea?schema=public

# Server
PORT=4000
NODE_ENV=development
# TRUST_PROXY=1  # set in production behind Render / CDN / reverse proxy

# JWT — use long random secrets in production (never commit real values)
JWT_SECRET=change-me-in-development
JWT_ACCESS_SECRET=change-me-access-in-development
JWT_REFRESH_SECRET=change-me-refresh-in-development
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Password reset + email verification (client URL for links; also used when SES is unset)
PASSWORD_RESET_URL_CLIENT=http://localhost:3000
# Prefer CLIENT_URL for storefront links (reset + verify); PASSWORD_RESET_URL_CLIENT is a fallback

# Apps
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
# Optional: register service worker in `next dev` (PWA registers automatically in production)
# NEXT_PUBLIC_PWA_DEV=1
# Google Merchant Center scheduled feeds (per market):
#   {NEXT_PUBLIC_SITE_URL}/feeds/google-merchant/ae
#   {NEXT_PUBLIC_SITE_URL}/feeds/google-merchant/tn
#   {NEXT_PUBLIC_SITE_URL}/feeds/google-merchant/other
# Optional comma-separated CORS allow-list (overrides CLIENT_URL + ADMIN_URL)
# CORS_ORIGINS=https://shop.example.com,https://admin.example.com

# Nest API URL for Next.js BFF route handlers
NEST_API_URL=http://localhost:4000/api

# On-demand ISR: Nest catalog mutations POST to CLIENT_URL/api/revalidate
REVALIDATE_SECRET=change-me-revalidate-in-development

# Google OAuth (customer sign-in) — create credentials in Google Cloud Console
# Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Stripe (optional — without these keys, checkout simulates capture in development)
# Test: sk_test_... / pk_test_...   Live (production only): sk_live_... / pk_live_...
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Encrypt payment secrets stored in StoreSettings (stripeSecretKey, konnectApiKey, konnectWalletId).
# AES-256-GCM; ciphertext prefix enc:v1:. Accepts 32-byte hex (64 chars) or base64.
# Generate: openssl rand -hex 32
# Without this key, DB values stay plaintext (dev); env fallbacks above are never encrypted.
# Alias: PAYMENT_SECRETS_ENCRYPTION_KEY
SETTINGS_SECRETS_KEY=

# Konnect (optional — TND card checkout; can also be set per-market in admin settings)
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=

# Amazon SES (optional — without these, mail no-ops and logs; password-reset / email-verification still print URLs)
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_FROM_NAME=Selfieface
# Optional: admin alert on new paid/COD orders + low-stock threshold crosses
# SES_ADMIN_NOTIFY_EMAIL=ops@example.com

# ClamAV daemon for scanning customer-provided support attachments.
# Uploads fail closed (not stored) when the scanner is unavailable or unset.
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Media CDN / public delivery (optional)
# Keep DB urls as /api/media/:id. When set, storefront/admin rewrite those paths
# to this origin (CDN or reverse proxy in front of Nest media).
# MEDIA_PUBLIC_BASE_URL is the server-side name; Next apps use NEXT_PUBLIC_MEDIA_URL.
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
# NEXT_PUBLIC_MEDIA_URL=https://cdn.example.com
# Alias also accepted by Next: NEXT_PUBLIC_MEDIA_CDN_URL
