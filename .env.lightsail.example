# Copy to .env.lightsail on the server. Do not commit that file.

# Domain and database
API_DOMAIN=api.chr-consults.com
POSTGRES_USER=lumea
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_DB=lumea

# Backend URLs: use the exact production domains shown in the Vercel projects.
CLIENT_URL=https://your-storefront.vercel.app
ADMIN_URL=https://your-admin.vercel.app
CORS_ORIGINS=https://your-storefront.vercel.app,https://your-admin.vercel.app
PUBLIC_API_URL=https://api.chr-consults.com
STOREFRONT_URL=https://your-storefront.vercel.app
REVALIDATE_SECRET=replace-with-a-long-random-secret

# Auth secrets: generate separate values with `openssl rand -hex 32`.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
SETTINGS_SECRETS_KEY=replace-with-64-hex-characters

# Amazon SES in Europe (Stockholm). Use a dedicated IAM user's restricted keys here.
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@chr-consults.com
SES_FROM_NAME=Selfieface

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.chr-consults.com/api/auth/google/callback
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
